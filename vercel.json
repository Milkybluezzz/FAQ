{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_NAME": "BandungAppFAQ",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://bandungappfaq.vercel.app",
    "APP_STORAGE": "/tmp",
    "CACHE_DRIVER": "file",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "@db_host",
    "DB_PORT": "3306",
    "DB_DATABASE": "@db_name",
    "DB_USERNAME": "@db_user",
    "DB_PASSWORD": "@db_pass"
  }
}
